# Copy this file to .env and fill in what you have.
# Every extractor degrades gracefully if its key is missing (see README),
# so the pipeline still runs with zero configuration -- these just unlock
# higher rate limits / additional sources.

# GitHub personal access token (no special scopes needed, just "public_repo"
# read access). Raises rate limit from 60/hr to 5000/hr.
# Create one at: https://github.com/settings/tokens
GITHUB_TOKEN=

# YouTube Data API v3 key. Required for the video extractor -- YouTube has
# no meaningful unauthenticated public API. Create one at:
# https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# Hugging Face access token. Optional -- public model listing works without
# it, this just raises rate limits.
HF_TOKEN=
